<?php

declare(strict_types=1);

/**
 * Set-password page for an account created without one.
 *
 * Rendered by SetPasswordHandler from the parameters
 * ProcessSetPasswordMiddleware leaves on the request. Passwords are never
 * re-populated: the POST re-renders an empty form with the errors.
 *
 * @var string|null                 $error
 * @var bool|null                   $expired
 * @var array<string, list<string>> $errors
 * @var string|null                 $token
 */

use Webware\UserManager\InputFilter\SetPasswordDataFilter;

$this->headTitle('Set Your Password');
?>
<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100 py-4">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
            <div class="card shadow-sm">
                <div class="card-body p-4 p-lg-5">

                    <?php if (! empty($error)): ?>

                        <div class="d-flex align-items-center gap-3 mb-4">
                            <i class="bi bi-shield-x fs-1 text-danger"></i>
                            <div>
                                <h1 class="h4 fw-bold mb-1">Password Not Set</h1>
                                <p class="text-secondary small mb-0">There was a problem with your activation link.</p>
                            </div>
                        </div>

                        <div class="alert alert-danger" role="alert">
                            <?= $this->escapeHtml($error) ?>
                        </div>

                        <?php if (! empty($expired)): ?>
                            <p class="text-secondary small mb-3">Enter your email address below and we will send you a new link.</p>
                            <form action="<?= $this->userUrl('resend.verification.create') ?>" method="post" novalidate>
                                <div class="mb-3">
                                    <label class="form-label form-label-sm fw-semibold" for="resend-email">Email</label>
                                    <input
                                        type="email"
                                        class="form-control"
                                        id="resend-email"
                                        name="email"
                                        placeholder="you@example.com"
                                        autocomplete="email"
                                        required
                                    >
                                </div>
                                <button type="submit" class="btn btn-primary w-100">Send a new link</button>
                            </form>
                        <?php endif; ?>

                    <?php else: ?>

                        <div class="d-flex align-items-center gap-3 mb-4">
                            <i class="bi bi-shield-lock fs-1 text-primary"></i>
                            <div>
                                <h1 class="h4 fw-bold mb-1">Set Your Password</h1>
                                <p class="text-secondary small mb-0">Choose a password to activate your account.</p>
                            </div>
                        </div>

                        <?php if (! empty($errors)): ?>
                            <div class="alert alert-danger py-2" role="alert">
                                <ul class="mb-0 ps-3 small">
                                    <?php foreach ($errors as $fieldMessages): ?>
                                        <?php foreach ($fieldMessages as $message): ?>
                                            <li><?= $this->escapeHtml($message) ?></li>
                                        <?php endforeach; ?>
                                    <?php endforeach; ?>
                                </ul>
                            </div>
                        <?php endif; ?>

                        <form
                            action="<?= $this->escapeHtmlAttr($this->userUrl('set.password.create', [
                                'token' => (string) $token,
                            ])) ?>"
                            method="post"
                            novalidate
                        >
                            <div class="mb-3">
                                <label class="form-label form-label-sm fw-semibold" for="password">Password</label>
                                <input
                                    type="password"
                                    class="form-control"
                                    id="password"
                                    name="passwordHash"
                                    autocomplete="new-password"
                                    minlength="<?= SetPasswordDataFilter::MINIMUM_LENGTH ?>"
                                    required
                                >
                                <div class="form-text">
                                    At least <?= SetPasswordDataFilter::MINIMUM_LENGTH ?> characters.
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label form-label-sm fw-semibold" for="confirmPassword">Confirm Password</label>
                                <input
                                    type="password"
                                    class="form-control"
                                    id="confirmPassword"
                                    name="confirmPasswordHash"
                                    autocomplete="new-password"
                                    required
                                >
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Set password and activate</button>
                        </form>

                    <?php endif; ?>

                    <div class="text-center mt-3">
                        <a href="<?= $this->userUrl(
                            'session.read',
                        ) ?>" class="small text-secondary">Already have an account? Sign in</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
