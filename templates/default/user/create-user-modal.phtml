<?php

/**
 * Create-user modal fragment.
 *
 * Rendered by CreateUserModalHandler (GET) and Http\Admin\RequestHandler\CreateUserHandler
 * (422 on a validation failure, 500 on a failed command). Both pass every variable below,
 * so the form keeps the submitted values and the error list survives a re-render.
 *
 * @var list<string>                $assignableRoles
 * @var array<string, list<string>> $errors
 * @var array<string, string>       $old
 */
$createUrl    = $this->escapeHtmlAttr($this->userAdminUrl('create'));
$selectedRole = $old['roleId'] ?? '';
?>
<div class="modal-dialog modal-sm">
<div class="modal-content">
<div class="modal-header py-2">
    <h5 class="modal-title small fw-bold" id="sharedModalLabel">
        <i class="bi bi-person-plus me-1"></i> Create User
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body">
    <?php if ([] !== $errors): ?>
    <div class="alert alert-danger py-2" role="alert">
        <ul class="mb-0 ps-3 small">
            <?php foreach ($errors as $fieldMessages): ?>
                <?php foreach ($fieldMessages as $message): ?>
                    <li><?= $this->escapeHtml($message) ?></li>
                <?php endforeach; ?>
            <?php endforeach; ?>
        </ul>
    </div>
    <?php endif; ?>
    <form
        id="createUserForm"
        hx-post="<?= $createUrl ?>"
        hx-target="main"
        hx-swap="innerHTML"
        hx-push-url="false"
    >
        <div class="mb-3">
            <label class="form-label small fw-semibold" for="create_first_name">
                First Name <span class="text-danger">*</span>
            </label>
            <input
                type="text"
                id="create_first_name"
                name="firstName"
                class="form-control form-control-sm"
                value="<?= $this->escapeHtmlAttr($old['firstName'] ?? '') ?>"
                required
            >
        </div>
        <div class="mb-3">
            <label class="form-label small fw-semibold" for="create_last_name">
                Last Name <span class="text-danger">*</span>
            </label>
            <input
                type="text"
                id="create_last_name"
                name="lastName"
                class="form-control form-control-sm"
                value="<?= $this->escapeHtmlAttr($old['lastName'] ?? '') ?>"
                required
            >
        </div>
        <div class="mb-3">
            <label class="form-label small fw-semibold" for="create_email">
                Email <span class="text-danger">*</span>
            </label>
            <input
                type="email"
                id="create_email"
                name="email"
                class="form-control form-control-sm"
                value="<?= $this->escapeHtmlAttr($old['email'] ?? '') ?>"
                required
            >
        </div>
        <div class="mb-0">
            <label class="form-label small fw-semibold" for="create_role_id">
                Role <span class="text-danger">*</span>
            </label>
            <?= $this->partial('user::partials/role-select', [
                'id'       => 'create_role_id',
                'roles'    => $assignableRoles,
                'selected' => $selectedRole,
            ]) ?>
            <div class="form-text">The account is created inactive; the user sets a password from the email.</div>
        </div>
    </form>
</div>
<div class="modal-footer py-2">
    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
    <button type="submit" form="createUserForm" class="btn btn-sm btn-primary">Create User</button>
</div>
</div>
</div>
