{
    "name": "webware/webware-usermanager",
    "description": "Mezzio user registration, authentication, email verification, and admin user management for the webware-* package family.",
    "license": "BSD-3-Clause",
    "keywords": [
        "webware",
        "user",
        "authentication",
        "mezzio"
    ],
    "authors": [
        {
            "name": "Joey Smith",
            "email": "jsmith@webinertia.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.4.1 || ~8.5.0",
        "laminas/laminas-diactoros": "^3.8",
        "laminas/laminas-permissions-acl": "^2.16",
        "mezzio/mezzio": "^3.26",
        "mezzio/mezzio-authentication": "^1.13",
        "mezzio/mezzio-authentication-session": "*",
        "mezzio/mezzio-router": "^3.15",
        "mezzio/mezzio-session": "^1.12",
        "php-db/phpdb-mysql": "0.5.x-dev",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "ramsey/uuid": "^4.9",
        "webware/webware-acl": "^0.1.x-dev",
        "webware/webware-core": "^0.1.x-dev",
        "webware/webware-htmx": "^0.1.x-dev",
        "webware/webware-log": "^1.1.x-dev",
        "webware/webware-mailer": "^1.0.x-dev",
        "webware/webware-message": "^1.0.x-dev",
        "webware/message-bus": "^2.0.x-dev",
        "webware/messagebus-event": "^2.0.x-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "webware/traccio": "^0.1.x-dev",
        "webware/webware-console": "^0.1.x-dev",
        "webware/webware-tools": "^0.1.x-dev"
    },
    "autoload": {
        "psr-4": {
            "Webware\\UserManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webware\\UserManagerTest\\": "test/unit/",
            "Webware\\UserManagerIntegrationTest\\": "test/integration/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "laminas/laminas-component-installer": true
        }
    }
}
