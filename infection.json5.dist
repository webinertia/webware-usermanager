{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 10,
    "threads": "max",
    "logs": {
        "text": "infection.log",
        "summary": "summary.log",
        "stryker": {
            // matches versioned release branches, e.g. "0.1.x", "0.2.x"
            "badge": "/^\\d+\\.\\d+\\.x$/"
        }
    },
    "mutators": {
        "@default": true,
        // The password prompt's hidden-input configuration and the redundant
        // (string) cast on the always-string role option are equivalent mutants:
        // they cannot be observed through CommandTester-based tests.
        "TrueValue": {
            "ignore": ["Webware\\UserManager\\Console\\InitDbCommand::questionFor::230"]
        },
        "FalseValue": {
            "ignore": ["Webware\\UserManager\\Console\\InitDbCommand::questionFor::231"]
        },
        "CastString": {
            "ignore": ["Webware\\UserManager\\Console\\InitDbCommand::resolveRole::241"]
        },
        // Configuration fallbacks (from_email/from_name/base_url/subject defaults
        // and the 86400-second token TTL default) are unobservable without
        // reflection: the built middleware keeps them private, so these
        // equivalent mutants cannot be detected through behaviour tests.
        "Coalesce": {
            "ignore": ["Webware\\UserManager\\Http\\Middleware\\Container\\ProcessResendVerificationMiddlewareFactory::__invoke"]
        },
        "IncrementInteger": {
            "ignore": ["Webware\\UserManager\\Http\\Middleware\\Container\\ProcessVerifyEmailMiddlewareFactory::__invoke"]
        },
        "DecrementInteger": {
            "ignore": ["Webware\\UserManager\\Http\\Middleware\\Container\\ProcessVerifyEmailMiddlewareFactory::__invoke"]
        }
    },
    "staticAnalysisTool": "mago"
}
