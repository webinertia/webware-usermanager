{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 10,
    "threads": "max",
    "logs": {
        "text": "infection.log",
        "summary": "summary.log",
        "stryker": {
            // matches versioned release branches, e.g. "0.1.x", "0.2.x"
            "badge": "/^\\d+\\.\\d+\\.x$/"
        }
    },
    "mutators": {
        "@default": true,
        // The password prompt's hidden-input configuration and the redundant
        // (string) cast on the always-string role option are equivalent mutants:
        // they cannot be observed through CommandTester-based tests.
        "TrueValue": {
            "ignore": ["Webware\\UserManager\\Console\\InitDbCommand::collectUser::158"]
        },
        "FalseValue": {
            "ignore": ["Webware\\UserManager\\Console\\InitDbCommand::collectUser::159"]
        },
        "CastString": {
            "ignore": ["Webware\\UserManager\\Console\\InitDbCommand::collectUser::162"]
        }
    },
    "staticAnalysisTool": "mago"
}
